#!name=MOA 版本伪装（强制升级测试）
#!desc=把 MOA 请求头 moa3versioncode 与 User-Agent 中的版本号伪装成新版，用于测试服务端是否据此判定强制升级。不需要时请关闭本插件。
#!author=Chief

[Script]
####################################分公司子域名
#!name=MOA 版本伪装（全国通用版）
#!desc=把 MOA 请求头 moa3versioncode 与 User-Agent 中的版本号伪装成新版，支持全地域省份节点。不需要时请关闭本插件。
#!author=Chief

# 【线路 1：国内加速镜像 - 默认启用（已改为全国省份通用正则）】
#http-request ^https?://[a-z]+\.moazq\.chinamobile\.com/moa5/api/interface/v1/api/(isNotUpgrade|getNewestVersion) script-path=https://ghproxy.net/https://raw.githubusercontent.com/leesincool6/loon/refs/heads/main/moa-spoof.js, requires-body=false, timeout=10, tag=MOA版本伪装

# 【线路 2：GitHub 官方直连 - 备用】若加速镜像失效，在上面那行开头加 # 注释掉，并删除本行开头的 # 即可切换
# http-request ^https?://[a-z]+\.moazq\.chinamobile\.com/moa5/api/interface/v1/api/(isNotUpgrade|getNewestVersion) script-path=https://raw.githubusercontent.com/leesincool6/loon/refs/heads/main/moa-spoof.js, requires-body=false, timeout=10, tag=MOA版本伪装

# 【线路 3：jsDelivr CDN 镜像 - 备用】
# http-request ^https?://[a-z]+\.moazq\.chinamobile\.com/moa5/api/interface/v1/api/(isNotUpgrade|getNewestVersion) script-path=https://fastly.jsdelivr.net/gh/leesincool6/loon@main/moa-spoof.js, requires-body=false, timeout=10, tag=MOA版本伪装

####################################单sc域名
# 【线路 1：国内加速镜像 - 默认启用】
http-request ^https?://sc\.moazq\.chinamobile\.com/moa5/api/interface/v1/api/(isNotUpgrade|getNewestVersion) script-path=https://ghproxy.net/https://raw.githubusercontent.com/leesincool6/loon/refs/heads/main/moa-spoof.js, requires-body=false, timeout=10, tag=MOA版本伪装

# 【线路 2：GitHub 官方直连 - 备用】若加速镜像失效，在上面那行开头加 # 注释掉，并删除本行开头的 # 即可切换
# http-request ^https?://sc\.moazq\.chinamobile\.com/moa5/api/interface/v1/api/(isNotUpgrade|getNewestVersion) script-path=https://raw.githubusercontent.com/leesincool6/loon/refs/heads/main/moa-spoof.js, requires-body=false, timeout=10, tag=MOA版本伪装

# 【原版，无需使用】
# http-request ^https?://sc\.moazq\.chinamobile\.com/moa5/api/interface/v1/api/(isNotUpgrade|getNewestVersion) script-path=http://192.168.143.199:8000/moa-spoof.js, requires-body=false, timeout=10, tag=MOA版本伪装

